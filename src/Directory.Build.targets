<Project>
  <Import Project="..\Directory.Build.targets" />

  <PropertyGroup>
    <!-- ChromaDB.Aspire publishes the Chroma integrations of CommunityToolkit/Aspire under its own package ids. -->
    <PackageId Condition="'$(MSBuildProjectName)' == 'CommunityToolkit.Aspire.Hosting.Chroma'">ChromaDotNet.Aspire.Hosting</PackageId>
    <PackageId Condition="'$(MSBuildProjectName)' == 'CommunityToolkit.Aspire.Chroma'">ChromaDotNet.Aspire.Client</PackageId>
    <_ChromaDotNetNote>Built from the Chroma integration proposed to the Community Toolkit for Aspire, until it ships there. Community project, not affiliated with the .NET Foundation, the Community Toolkit or Chroma.</_ChromaDotNetNote>
    <!-- The descriptions of the ChromaDotNet.Aspire packages, in place of the ones in the project files of the toolkit. The client
         integration connects to Chroma Cloud too; the hosting integration runs a Chroma container. -->
    <PackageDescription Condition="'$(MSBuildProjectName)' == 'CommunityToolkit.Aspire.Hosting.Chroma'">Aspire hosting integration for Chroma: a Chroma container in the AppHost. $(_ChromaDotNetNote)</PackageDescription>
    <PackageDescription Condition="'$(MSBuildProjectName)' == 'CommunityToolkit.Aspire.Chroma'">Aspire client integration for Chroma and Chroma Cloud: a ChromaClient of ChromaDotNet.Client with health checks, traces and metrics. $(_ChromaDotNetNote)</PackageDescription>
    <Authors>ChromaDotNet contributors</Authors>
    <Copyright>(c) .NET Foundation and Contributors. (c) 2026 ChromaDotNet contributors.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>ChromaDB.Aspire</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ChromaDotNet/ChromaDB.Aspire</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChromaDotNet/ChromaDB.Aspire</RepositoryUrl>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageOutputPath>../../nuget</PackageOutputPath>
    <!-- The tags of the ChromaDotNet packages, in place of those of the toolkit, as the other ChromaDotNet packages. -->
    <PackageTags Condition="'$(MSBuildProjectName)' == 'CommunityToolkit.Aspire.Hosting.Chroma'">aspire integration hosting chroma chromadb vector-database</PackageTags>
    <PackageTags Condition="'$(MSBuildProjectName)' == 'CommunityToolkit.Aspire.Chroma'">aspire integration client chroma chromadb chroma-cloud vector-database</PackageTags>
    <PackageTags Condition="'$(EnableAspireIntegrationAnalyzers)' == 'true'
                            and '$(IsAspirePolyglotCompatible)' != 'false'
                            and !$([System.String]::Concat(' ', '$(PackageTags)', ' ').Contains(' polyglot '))">$([System.String]::Concat('$(PackageTags)', ' polyglot').Trim())</PackageTags>
    
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../icon.png" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Create local branding
  -->
  <PropertyGroup Condition=" '$(ContinuousIntegrationBuild)' == 'false' AND  '$(VersionSuffix)' == ''  ">
    <_VersionSuffix>$([System.DateTime]::Now.ToString(yyMMdd-HHmm))</_VersionSuffix>
    <VersionSuffix>dev.$(_VersionSuffix)</VersionSuffix>
    <PackageVersion>$(VersionPrefix)-$(VersionSuffix)</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <WarningsAsErrors>$(DefaultWarningsAsErrors);$(WarningsAsErrors)</WarningsAsErrors>
  </PropertyGroup>
</Project>